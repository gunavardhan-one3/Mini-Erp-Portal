# PostgreSQL connection string used by Prisma
# Note: local dev Postgres (Docker) runs on host port 5433 to avoid clashing
# with any native Postgres install already using 5432 on this machine.
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5433/erp_crm?schema=public"

# Secret used to sign/verify JWTs. Use a long random string in production.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the Express server listens on
PORT=4000

# Deployed frontend origin, used to restrict CORS in production.
# Leave unset locally to allow all origins.
# FRONTEND_URL="https://your-app.vercel.app"
